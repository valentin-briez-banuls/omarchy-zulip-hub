{
  "schemaVersion": 1,
  "id": "io.github.valentin-briez-banuls.zulip-hub",
  "name": "Zulip Hub",
  "version": "2.0.0",
  "author": "Valentin Briez-Banuls",
  "license": "MIT",
  "description": "Zulip unread counters and recent conversations in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Zulip Hub",
    "description": "Show Zulip mentions, direct messages, and recent conversations.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showTotal": true,
      "showMentions": true,
      "hideWhenEmpty": false,
      "refreshIntervalSec": 2
    },
    "schema": [
      {
        "key": "showTotal",
        "type": "boolean",
        "label": "Show total unread count",
        "defaultValue": true
      },
      {
        "key": "showMentions",
        "type": "boolean",
        "label": "Highlight mentions",
        "defaultValue": true
      },
      {
        "key": "hideWhenEmpty",
        "type": "boolean",
        "label": "Hide when there are no unread messages",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Fallback refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
